{
  "metafileVersion": 1,
  "label": "Retro: Dither",
  "about": { "author_name": "FiniteSingularity (ported)", "author_url": "https://github.com/FiniteSingularity/obs-retro-effects" },
  "parameters": [
    { "name": "dither_type", "label": "Dither Type", "type": "list_int", "values": [ { "value": 1, "label": "Ordered" }, { "value": 2, "label": "Unordered" } ], "default": 1 },
    { "name": "dither_bayer_size", "label": "Bayer Matrix Size", "type": "list_int", "values": [ { "value": 2, "label": "2x2" }, { "value": 4, "label": "4x4" }, { "value": 8, "label": "8x8" } ], "default": 4, "if": ["dither_type", "==", 1] },
    { "name": "dither_size", "label": "Dither Size", "type": "float", "slider": true, "min": 0.4, "max": 10.0, "step": 0.1, "default": 1.0 },
    { "name": "dither_color_steps", "label": "Colors Per Channel", "type": "int", "slider": true, "min": 1, "max": 32, "step": 1, "default": 1 },
    { "name": "dither_mono", "label": "Monochromatic?", "type": "bool", "default": false },
    { "name": "dither_round", "label": "Round To Pixel?", "type": "bool", "default": true },
    { "name": "dither_contrast", "label": "Contrast Adjustment", "type": "float", "slider": true, "min": -1.0, "max": 1.0, "step": 0.1, "default": 0.0 },
    { "name": "dither_gamma", "label": "Gamma Adjustment", "type": "float", "slider": true, "min": 0.25, "max": 2.0, "step": 0.025, "default": 1.0 },
    { "name": "dither_offset_x", "label": "Offset X", "type": "float", "slider": true, "min": -4000.0, "max": 4000.0, "step": 1.0, "default": 0.0, "if": ["dither_type", "==", 2] },
    { "name": "dither_offset_y", "label": "Offset Y", "type": "float", "slider": true, "min": -4000.0, "max": 4000.0, "step": 1.0, "default": 1.0, "if": ["dither_type", "==", 2] }
  ]
}
