{
  "metafileVersion": 1,
  "label": "Retro: Matrix Rain",
  "about": {
    "author_name": "FiniteSingularity (ported)",
    "author_url": "https://github.com/FiniteSingularity/obs-retro-effects",
    "description": "Matrix Rain filter from obs-retro-effects 1.0.2, ported to the Silly Cam Filters engine. Includes the original bloom."
  },
  "parameters": [
    {
      "name": "matrix_char_set", "label": "Character Set", "type": "list_int", "default": 1,
      "values": [
        { "value": 0, "label": "Custom Character Texture" },
        { "value": 1, "label": "Matrix Rain" },
        { "value": 2, "label": "ASCII 70 Chars" },
        { "value": 3, "label": "ASCII 10 Chars" },
        { "value": 4, "label": "Emojis" }
      ]
    },
    {
      "name": "matrix_rain_custom_texture_group", "label": "Custom Characters", "type": "group",
      "if": ["matrix_char_set", "==", 0],
      "parameters": [
        { "name": "matrix_rain_texture", "label": "Texture File", "type": "image", "allow_custom": true },
        { "name": "matrix_rain_texture_chars", "label": "Character Count", "type": "int", "min": 1, "max": 255, "step": 1, "default": 1 },
        {
          "name": "matrix_rain_app_info", "label": "", "type": "text",
          "value": "<a href=\"https://finitesingularity.github.io/matrix-rain-tex-gen/\">Click Here</a> to use the matrix-rain texture web app to generate a texture file. Set your font, size and other parameters, then click the Generate Texture button, save the texture to your computer, and select it in the 'Texture File' field above. Then set the 'Character Count' field to the number of characters in your texture."
        }
      ]
    },
    { "name": "matrix_font_matrix",  "label": "Matrix Rain",    "type": "image", "hidden": true, "allow_custom": false, "default": "matrix-font-56.png",              "values": [ { "label": "Matrix Rain",    "value": "matrix-font-56.png" } ] },
    { "name": "matrix_font_ascii70", "label": "ASCII 70 Chars", "type": "image", "hidden": true, "allow_custom": false, "default": "ascii-test.png",                  "values": [ { "label": "ASCII 70 Chars", "value": "ascii-test.png" } ] },
    { "name": "matrix_font_ascii10", "label": "ASCII 10 Chars", "type": "image", "hidden": true, "allow_custom": false, "default": "ascii-font-2-200x30x10chars.png", "values": [ { "label": "ASCII 10 Chars", "value": "ascii-font-2-200x30x10chars.png" } ] },
    { "name": "matrix_font_emojis",  "label": "Emojis",         "type": "image", "hidden": true, "allow_custom": false, "default": "emojis-52.png",                   "values": [ { "label": "Emojis",         "value": "emojis-52.png" } ] },

    { "name": "matrix_rain_scale", "label": "Scale", "type": "float", "slider": true, "min": 0.01, "max": 20.0, "step": 0.01, "default": 0.4 },
    { "name": "matrix_rain_noise_shift", "label": "Noise Shift", "type": "float", "slider": true, "min": -4000.0, "max": 4000.0, "step": 0.1, "default": 0.0 },
    { "name": "matrix_rain_colorize", "label": "Colorize?", "type": "bool", "default": false },
    { "name": "matrix_rain_text_color", "label": "Text Color", "type": "color", "default": "#FF6EF789" },
    { "name": "matrix_rain_background_color", "label": "Background Color", "type": "color", "default": "#FF000000" },
    { "name": "matrix_min_brightness", "label": "Black Level", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0 },
    { "name": "matrix_max_brightness", "label": "White Level", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 1.0 },
    { "name": "matrix_min_fade_value", "label": "Minimum Fade Value", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.0 },
    { "name": "matrix_active_rain_brightness", "label": "Active Rain Brightness", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3 },
    { "name": "matrix_fade_distance", "label": "Fade Distance", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.8 },
    { "name": "matrix_speed_factor", "label": "Rain Speed", "type": "float", "slider": true, "min": 0.0, "max": 10.0, "step": 0.01, "default": 1.0 },
    { "name": "matrix_bloom_radius", "label": "Bloom Radius", "type": "float", "slider": true, "min": 0.0, "max": 20.0, "step": 0.01, "default": 6.0 },
    { "name": "matrix_bloom_threshold", "label": "Bloom Threshold", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.3, "description": "The original plugin ignores this setting and always uses 0.4; this port does the same." },
    { "name": "matrix_bloom_intensity", "label": "Bloom Intensity", "type": "float", "slider": true, "min": 0.0, "max": 3.0, "step": 0.01, "default": 2.25 }
  ],
  "passes": [
    { "name": "mr_rain",   "technique": "Rain" },
    { "name": "mr_bright", "technique": "Bright" },
    { "name": "mr_blur_h", "technique": "BlurH" },
    { "name": "mr_out",    "technique": "Combine" }
  ]
}
