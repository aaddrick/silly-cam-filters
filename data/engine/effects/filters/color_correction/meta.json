{
  "metafileVersion": 1,
  "label": "Color Correction",
  "about": { "author_name": "c3r1c3 / OBS Project (ported)", "author_url": "https://github.com/obsproject/obs-studio" },
  "parameters": [
    { "name": "gamma",          "label": "Gamma",          "type": "float", "slider": true, "min": -3.0, "max": 3.0,   "step": 0.01,   "default": 0.0 },
    { "name": "contrast",       "label": "Contrast",       "type": "float", "slider": true, "min": -4.0, "max": 4.0,   "step": 0.01,   "default": 0.0 },
    { "name": "brightness",     "label": "Brightness",     "type": "float", "slider": true, "min": -1.0, "max": 1.0,   "step": 0.0001, "default": 0.0 },
    { "name": "saturation",     "label": "Saturation",     "type": "float", "slider": true, "min": -1.0, "max": 5.0,   "step": 0.01,   "default": 0.0 },
    { "name": "hue_shift",      "label": "Hue Shift",      "type": "float", "slider": true, "min": -180.0, "max": 180.0, "step": 0.01, "default": 0.0 },
    { "name": "opacity",        "label": "Opacity",        "type": "float", "slider": true, "min": 0.0,  "max": 1.0,   "step": 0.0001, "default": 1.0 },
    { "name": "color_multiply", "label": "Color Multiply", "type": "color", "default": "#FFFFFF" },
    { "name": "color_add",      "label": "Color Add",      "type": "color", "default": "#000000" }
  ]
