{
  "metafileVersion": 1,
  "label": "Retro: CRT",
  "about": {
    "author_name": "FiniteSingularity (ported)",
    "author_url": "https://github.com/FiniteSingularity/obs-retro-effects",
    "description": "CRT screen: phosphor mask, phosphor bloom, barrel distortion, vignette, rounded corners and black/white levels. Port of the CRT filter from obs-retro-effects 1.0.2."
  },
  "parameters": [
    {
      "name": "crt_phosphor_mask", "label": "Phosphor Mask", "type": "group",
      "parameters": [
        { "name": "crt_phosphor_type", "label": "Phosphor Layout", "type": "int", "slider": true, "min": 0, "max": 24, "step": 1, "default": 17 },
        { "name": "crt_mask_intensity", "label": "Intensity", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 70.0 }
      ]
    },
    {
      "name": "crt_phosphor_bloom", "label": "Phosphor Bloom", "type": "group",
      "parameters": [
        { "name": "crt_bloom", "label": "Bloom Size", "type": "float", "slider": true, "min": 0.0, "max": 32.0, "step": 0.1, "default": 5.0 },
        { "name": "crt_bloom_threshold", "label": "Threshold", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 75.0 },
        { "name": "crt_bloom_intensity", "label": "Intensity", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 50.0 }
      ]
    },
    {
      "name": "crt_geometry", "label": "CRT Geometry", "type": "group",
      "parameters": [
        { "name": "crt_corner_radius", "label": "Corner Radius", "type": "float", "slider": true, "min": 0.0, "max": 500.0, "step": 1.0, "default": 25.0 },
        { "name": "crt_barrel_distort", "label": "Barrel Distortion", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 1.7 },
        { "name": "crt_vignette", "label": "Vignette Amount", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 15.0 }
      ]
    },
    {
      "name": "crt_color_correction", "label": "Color Correction", "type": "group",
      "parameters": [
        { "name": "crt_black_level", "label": "Black Level", "type": "float", "slider": true, "min": 0.0, "max": 255.0, "step": 0.1, "default": 20.0 },
        { "name": "crt_white_level", "label": "White Level", "type": "float", "slider": true, "min": 0.0, "max": 255.0, "step": 0.1, "default": 190.0 }
      ]
    }
  ],
  "passes": [
    { "name": "mask",   "technique": "Mask" },
    { "name": "bright", "technique": "Bright", "scale": 0.5 },
    { "name": "blurh",  "technique": "BlurH",  "scale": 0.5 },
    { "name": "blurv",  "technique": "BlurV",  "scale": 0.5 },
    { "name": "result", "technique": "Composite" }
  ]
}
