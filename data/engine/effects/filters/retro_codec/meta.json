{
  "metafileVersion": 1,
  "label": "Retro: Codec",
  "about": {
    "author_name": "FiniteSingularity (ported)",
    "author_url": "https://github.com/FiniteSingularity/obs-retro-effects",
    "description": "Retro Codec filter from obs-retro-effects 1.0.2 (RPZA / old FMV shader by Millennium Cyborg), ported to the Silly Cam Filters engine."
  },
  "parameters": [
    {
      "name": "codec_type", "label": "Codec Type", "type": "list_int", "default": 1,
      "values": [ { "value": 1, "label": "Old FMV (RPZA)" } ]
    },
    { "name": "codec_px_scale", "label": "Pixel Scale", "type": "float", "slider": true, "min": 1.0, "max": 16.0, "step": 0.01, "default": 5.0 },
    { "name": "codec_colors_per_channel", "label": "Colors Per Channel", "type": "int", "slider": true, "min": 1, "max": 256, "step": 1, "default": 32 },
    { "name": "codec_quality", "label": "Quality", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.85 },
    { "name": "codec_keyframe_interval", "label": "Keyframe Interval (seconds, 0 = off)", "type": "float", "slider": true, "min": 0.0, "max": 10.0, "step": 0.01, "default": 3.0 },
    { "name": "codec_custom_thresholds", "label": "Custom Thresholds", "type": "bool", "default": false },
    {
      "name": "codec_thresholds_group", "label": "Custom Thresholds", "type": "group",
      "if": ["codec_custom_thresholds", "==", true],
      "parameters": [
        { "name": "codec_rpza_threshold_prev_frame", "label": "Threshold: Take Block From Previous Frame", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.14 },
        { "name": "codec_rpza_threshold_solid", "label": "Threshold: Solid Color Block", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.1 },
        { "name": "codec_rpza_threshold_gradient", "label": "Threshold: 4-Color Gradient Block", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.18 }
      ]
    }
  ],
  "passes": [
    { "name": "codec_out", "technique": "RPZA" }
  ]
}
