{
  "metafileVersion": 1,
  "label": "Falling Sand",
  "about": {
    "author_name": "Silly Cam Filters",
    "description": "Bright parts of the picture crumble into sand that falls and piles up at the bottom of the frame."
  },
  "parameters": [
    {
      "name": "threshold",
      "label": "Brightness threshold",
      "type": "float",
      "slider": true,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "default": 0.6
    },
    {
