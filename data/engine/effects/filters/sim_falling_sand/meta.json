      "label": "Gravity speed",
      "type": "int",
      "slider": true,
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "name": "spawn_rate",
      "label": "New sand from the camera",
      "type": "float",
      "slider": true,
      "min": 0.0,
      "max": 0.2,
      "step": 0.002,
      "default": 0.004
    },
    {
      "name": "initial_sand",
      "label": "Sand at start and reset",
      "type": "float",
      "slider": true,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "default": 0.25
    },
    {
      "name": "sink_rate",
      "label": "Sand drain at the bottom",
      "type": "float",
      "slider": true,
      "min": 0.0,
      "max": 0.2,
      "step": 0.002,
      "default": 0.02
    },
    {
      "name": "evaporate",
      "label": "Sand evaporates (keeps the pile low)",
      "type": "float",
      "slider": true,
      "min": 0.0,
      "max": 0.05,
