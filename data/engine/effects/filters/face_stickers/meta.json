{
  "metafileVersion": 1,
  "label": "[Face Tracking] Face Stickers",
  "about": {
    "author_name": "Silly Cam Filters",
    "author_url": "",
    "description": "Stickers that stick to your face: clown nose, curly mustache, goofy glasses, all three, or your own PNG. They follow the head's position, size and tilt. Sticker art is original, drawn by gen_stickers.py in this folder."
  },
  "parameters": [
    {
      "type": "facetracking",
      "name": "fd",
      "use_preraster": true,
      "reset_on_face_lost": { "prompt": true, "default": true }
    },
    {
      "name": "sticker", "label": "Sticker", "type": "list_int", "default": 3,
      "values": [
        { "value": 0, "label": "Clown nose" },
        { "value": 1, "label": "Curly mustache" },
        { "value": 2, "label": "Goofy glasses" },
        { "value": 3, "label": "Full disguise (all three)" },
        { "value": 4, "label": "My own image" }
      ]
    },
    {
      "name": "custom_image", "label": "My image (PNG with transparency)", "type": "image",
      "if": ["sticker", "==", 4]
    },
    {
      "name": "custom_anchor", "label": "Stick my image on", "type": "list_int", "default": 0,
      "if": ["sticker", "==", 4],
      "values": [
        { "value": 0, "label": "Nose" },
        { "value": 1, "label": "Upper lip" },
        { "value": 2, "label": "Eyes" },
        { "value": 3, "label": "Forehead" },
        { "value": 4, "label": "Chin" }
      ]
    },
    {
      "name": "custom_width", "label": "My image width", "type": "float", "slider": true,
      "min": 0.2, "max": 4.0, "step": 0.05, "default": 1.5,
      "if": ["sticker", "==", 4],
      "description": "Width in eye distances (1 = the distance between the eye centres)."
    },
    { "name": "img_nose", "label": "Clown nose", "type": "image", "hidden": true, "allow_custom": false, "default": "sticker_nose.png", "values": [ { "label": "Clown nose", "value": "sticker_nose.png" } ] },
    { "name": "img_mustache", "label": "Curly mustache", "type": "image", "hidden": true, "allow_custom": false, "default": "sticker_mustache.png", "values": [ { "label": "Curly mustache", "value": "sticker_mustache.png" } ] },
    { "name": "img_glasses", "label": "Goofy glasses", "type": "image", "hidden": true, "allow_custom": false, "default": "sticker_glasses.png", "values": [ { "label": "Goofy glasses", "value": "sticker_glasses.png" } ] },
    {
      "name": "size", "label": "Size", "type": "float", "slider": true,
      "min": 0.5, "max": 2.0, "step": 0.01, "default": 1.0
    },
    {
      "name": "offset_x", "label": "Move sideways", "type": "float", "slider": true,
      "min": -1.0, "max": 1.0, "step": 0.01, "default": 0.0,
      "description": "In eye distances, along the line of the eyes (follows head tilt)."
    },
    {
      "name": "offset_y", "label": "Move up / down", "type": "float", "slider": true,
      "min": -1.0, "max": 1.0, "step": 0.01, "default": 0.0,
      "description": "In eye distances, down the face (follows head tilt). Negative = up."
    }
  ],
  "passes": [
    { "name": "presence", "technique": "Presence", "size": [1, 1], "format": "rgba16f" },
    { "name": "out", "technique": "Draw" }
  ]
}
