{
  "metafileVersion": 1,
  "label": "[Face Tracking] Voice Waveform Ring",
  "about": { "author_name": "Silly Cam Filters", "description": "A glowing ring around your head that spikes with your voice; the last two seconds of sound travel around it from the top. No audio source = no ring." },
  "parameters": [
    { "type": "facetracking", "name": "fd", "use_preraster": true, "reset_on_face_lost": { "prompt": true, "default": true } },
    { "name": "audio_level", "label": "Audio Source", "type": "audiolevel" },
    { "name": "sensitivity", "label": "Sensitivity", "type": "float", "slider": true, "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.6 },
    { "name": "ring_color", "label": "Ring color", "type": "color", "default": "#FF39F2FF" },
    { "name": "thickness", "label": "Thickness", "type": "float", "slider": true, "min": 0.02, "max": 0.3, "step": 0.005, "default": 0.07 },
    { "name": "spike_height", "label": "Spike height", "type": "float", "slider": true, "min": 0.1, "max": 2.0, "step": 0.05, "default": 0.9 }
  ],
  "passes": [
    { "name": "env", "technique": "Env", "size": [1, 1], "format": "rgba32f" },
    { "name": "pres", "technique": "Pres", "size": [1, 1], "format": "rgba32f" },
    { "name": "hist", "technique": "Hist", "size": [64, 1], "format": "rgba16f" },
    { "name": "out", "technique": "Draw" }
  ]
}
