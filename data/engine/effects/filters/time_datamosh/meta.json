{
  "metafileVersion": 1,
  "label": "Datamosh",
  "about": { "author_name": "Silly Cam Filters", "description": "The glitchy video-compression look: still parts freeze while moving parts smear and drag the old picture along. It refreshes itself every few seconds." },
  "parameters": [
    { "name": "smear", "label": "Smear on", "type": "bool", "default": true },
    { "name": "block_size", "label": "Block size", "type": "int", "slider": true, "min": 1, "max": 4, "step": 1, "default": 1 },
    { "name": "refresh_interval", "label": "Refresh every (seconds)", "type": "float", "slider": true, "min": 1.0, "max": 20.0, "step": 0.5, "default": 3.0 },
    { "name": "leak", "label": "Still areas recover", "type": "float", "slider": true, "min": 0.0, "max": 0.2, "step": 0.005, "default": 0.06 },
    { "name": "drop_keyframe", "label": "Drop keyframe now", "type": "bool", "default": false }
  ],
  "passes": [
    { "name": "mv", "technique": "Motion", "scale": 0.125, "format": "rgba16f" },
    { "name": "mosh", "technique": "Mosh", "format": "rgba16" }
  ]
}
