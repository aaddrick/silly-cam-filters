{
  "metafileVersion": 1,
  "label": "Retro: Cathode Boot",
  "about": {
    "author_name": "FiniteSingularity (ported)",
    "author_url": "https://github.com/FiniteSingularity/obs-retro-effects",
    "description": "Old CRT TV turning on or off: the picture collapses to a glowing line, then a dot, then fades. Port of the Cathode Boot filter from obs-retro-effects 1.0.2, with an optional automatic animation."
  },
  "parameters": [
    {
      "name": "cathode_boot_auto", "label": "Animation", "type": "list_int", "default": 1,
      "description": "Manual uses the Progress slider. The other modes play the animation each time the source is shown.",
      "values": [
        { "value": 0, "label": "Manual (Progress slider)" },
        { "value": 1, "label": "Power on when shown" },
        { "value": 2, "label": "Power off when shown" }
      ]
    },
    { "name": "cathode_boot_progress", "label": "Progress", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.01, "default": 0.0, "if": ["cathode_boot_auto", "==", 0] },
    { "name": "cathode_boot_duration", "label": "Duration", "type": "float", "slider": true, "min": 0.1, "max": 10.0, "step": 0.1, "default": 1.5, "if": ["cathode_boot_auto", "!=", 0] },
    { "name": "cathode_boot_delay", "label": "Delay", "type": "float", "slider": true, "min": 0.0, "max": 10.0, "step": 0.1, "default": 0.0, "if": ["cathode_boot_auto", "!=", 0] },
    {
      "name": "cathode_boot_terminal_line", "label": "Terminal Line Settings", "type": "group",
      "parameters": [
        { "name": "cathode_boot_vert_thickness", "label": "Vertical Thickness", "type": "float", "slider": true, "min": 1.0, "max": 30.0, "step": 1.0, "default": 1.0 },
        { "name": "cathode_boot_horiz_thickness", "label": "Horizontal Thickness", "type": "float", "slider": true, "min": 1.0, "max": 30.0, "step": 1.0, "default": 1.0 },
        { "name": "cathode_boot_glow_size", "label": "Glow Size", "type": "float", "slider": true, "min": 1.0, "max": 30.0, "step": 1.0, "default": 2.0 },
        { "name": "cathode_boot_glow_color", "label": "Glow Color", "type": "color", "default": "#FFFFFFFF" },
        { "name": "cathode_boot_bg_color", "label": "Background Color", "type": "color", "default": "#FF000000" }
      ]
    },
    {
      "name": "cathode_boot_timing", "label": "Timing", "type": "group",
      "parameters": [
        { "name": "cathode_boot_vert_start", "label": "Vertical Start", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 0.0 },
        { "name": "cathode_boot_vert_end", "label": "Vertical End", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 70.0 },
        { "name": "cathode_boot_horiz_start", "label": "Horizontal Start", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 50.0 },
        { "name": "cathode_boot_horiz_end", "label": "Horizontal End", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 90.0 },
        { "name": "cathode_boot_fade_start", "label": "Fade Start", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 90.0 },
        { "name": "cathode_boot_fade_end", "label": "Fade End", "type": "float", "slider": true, "min": 0.0, "max": 100.0, "step": 0.1, "default": 100.0 }
      ]
    }
  ]
}
